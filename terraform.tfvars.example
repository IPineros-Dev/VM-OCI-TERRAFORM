# ==============================================================================
# Plantilla de variables para OCI + Terraform
# 1. Copia este archivo: cp terraform.tfvars.example terraform.tfvars
# 2. Completa los campos vacíos con los datos de TU cuenta de OCI
# 3. NUNCA subas `terraform.tfvars` a Git (está protegido por .gitignore)
# ==============================================================================

# --- Autenticación con tu cuenta de OCI ---
tenancy_ocid     = ""
user_ocid        = ""
fingerprint      = ""
private_key_path = "./keys/oci_api_key.pem"
region           = "" # Ejemplo: "sa-saopaulo-1", "us-ashburn-1", "sa-bogota-1"

# --- Infraestructura existente en OCI ---
compartment_ocid = ""
subnet_ocid      = ""

# --- Especificaciones de la Máquina Virtual ---
vm_display_name         = "oci-vm-automatic"
vm_shape                = "VM.Standard.E5.Flex" # Recomendado en Free Trial / PAYG. Si tu cuenta es solo Always Free, usa "VM.Standard.E2.1.Micro"
vm_ocpus                = 1
vm_memory_in_gbs        = 2
boot_volume_size_in_gbs = 50
os_name                 = "Canonical Ubuntu"
os_version              = "24.04"
ssh_public_key_path     = "./keys/oci_vm_key.pub"

# --- Firewall (Network Security Group) ---
allowed_tcp_ports = [22, 80, 443]
ingress_cidr      = "0.0.0.0/0"

# --- Aprovisionamiento automático inicial (cloud-init) ---
enable_cloud_init = true
git_repo_url      = "https://github.com/adanbeltran/ecored-estatica.git"
web_root_dir      = "/var/www/ecored-estatica"
